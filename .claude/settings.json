{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "go",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "run", "./tools/claudehook", "pre"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "go",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "run", "./tools/claudehook", "post"],
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "run", "./tools/claudehook", "stop"],
            "timeout": 300
          },
          {
            "type": "command",
            "command": "go",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "run", "./tools/claudehook", "review"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
