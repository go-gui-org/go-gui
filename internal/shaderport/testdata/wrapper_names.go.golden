package shaders

import "github.com/go-gui-org/go-gui/gui"

// ported draws the ported shader. Set it as a container's Shader.
var ported = &gui.Shader{
	Metal: `
float4 frag_color = float4(0.0);
mainImage(frag_color, float2((in.uv.x * 0.5 + 0.5) * iResolution.x, (0.5 - in.uv.y * 0.5) * iResolution.y), iResolution);
frag_color.a = 1.0;
`,
	MetalDecls: `
// Program-scope names the go-gui wrapper also declares: a palette
// function named color and a constant named tex. Both get renamed.
constant float tex_ = 0.75;

float3 color_(float t)
{
    return 0.5 + 0.5 * cos(6.28318 * (t + float3(0.0, 0.33, 0.67)));
}

void mainImage(thread float4& fragColor, float2 fragCoord, float3 iResolution)
{
    float2 uv = fragCoord / iResolution.xy;
    fragColor = float4(color_(uv.x) * tex_, 1.0);
}
`,
	GLSL: `
vec4 frag_color = vec4(0.0);
mainImage(frag_color, vec2((uv.x * 0.5 + 0.5) * iResolution.x, (0.5 - uv.y * 0.5) * iResolution.y));
frag_color.a = 1.0;
`,
	GLSLDecls: `
// Program-scope names the go-gui wrapper also declares: a palette
// function named color and a constant named tex. Both get renamed.
const float tex_ = 0.75;

vec3 color_(float t)
{
    return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67)));
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    vec2 uv = fragCoord / iResolution.xy;
    fragColor = vec4(color_(uv.x) * tex_, 1.0);
}
`,
}
